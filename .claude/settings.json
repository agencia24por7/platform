{
  "agent": "arquiteto",
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./package-lock.json)",
      "Read(./tsconfig.tsbuildinfo)",
      "Read(./.claude/worktrees/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./n8n-limpeza-*.json)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/credentials.json)",
      "Read(./**/service-account*.json)"
    ],
    "ask": [
      "Bash(git push --force:*)"
    ],
    "allow": [
      "Bash(terraform:*)",
      "Bash(gcloud:*)",
      "Bash(gh:*)",
      "Bash(bq:*)",
      "Bash(scripts/vm-ligar.sh:*)",
      "Bash(scripts/vm-desligar.sh:*)",
      "Bash(ssh:*)",
      "mcp__claude-in-chrome__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bootstrap-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda-pre-uso.mjs\"  || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "effortLevel": "medium"
}
