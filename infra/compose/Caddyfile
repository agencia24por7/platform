{
	email {$ACME_EMAIL}
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

(seguranca) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}

(corpo_publico) {
	@upload_de_contexto path /api/contexto/*
	@corpo_padrao not path /api/contexto/*

	request_body @upload_de_contexto {
		max_size 30MB
	}

	request_body @corpo_padrao {
		max_size 1MB
	}
}

{$APP_HOST} {
	import seguranca
	import corpo_publico
	encode zstd gzip

	@cofre_de_tokens path /api/v0/coleta/token /api/v0/coleta/token/* /api/v0/tokens /api/v0/tokens/* /api/v0/tarefas/token /api/v0/tarefas/token/*
	respond @cofre_de_tokens 404

	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto https
		header_up X-Orla-Borda "{$TRIA_PROXY_SECRET}"
	}
}

import /etc/caddy/conf.d/*.caddy
