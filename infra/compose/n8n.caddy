{$N8N_HOST} {
	import seguranca
	encode zstd gzip

	@corpo_de_webhook path /api/portaria/receber* /webhook/*
	@corpo_do_editor not path /api/portaria/receber* /webhook/*

	request_body @corpo_de_webhook {
		max_size 1MB
	}

	request_body @corpo_do_editor {
		max_size 16MB
	}

	@portaria path /api/portaria/receber*

	handle @portaria {
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto https
			header_up X-Orla-Borda "{$TRIA_PROXY_SECRET}"
		}
	}

	@webhooks_publicos path /webhook/meta-leads-36b523ec1f6f6c03a3ef /webhook/credaz-rd-WQMJzJWbDcykuWO3qV8EU6E /webhook/credaz-rd-conversoes-c41d9e7a2b

	handle @webhooks_publicos {
		reverse_proxy n8n:5678 {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		forward_auth app:3000 {
			uri /api/portaria
			header_up X-Original-URI {uri}
			header_up X-Forwarded-Proto https
		}

		reverse_proxy n8n:5678 {
			header_up X-Forwarded-Proto https
		}
	}
}
