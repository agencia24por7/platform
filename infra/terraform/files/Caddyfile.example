{
    email {$ACME_EMAIL}
    admin off
}

{$APP_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        -Server
    }

    basic_auth {
        {$PROXY_BASIC_AUTH}
    }

    reverse_proxy app:3000
}
