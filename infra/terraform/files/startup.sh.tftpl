#!/bin/bash
set -euo pipefail

exec > >(tee /var/log/tria-startup.log) 2>&1

readonly PROJECT_ID="${project_id}"
readonly PREFIX="${prefix}"
readonly APP_HOST="${app_hostname}"
readonly N8N_HOST="${n8n_hostname}"
readonly ACME_EMAIL="${acme_email}"
readonly STACK=/opt/tria

mkdir -p "$STACK"

IMAGEM_ATUAL=$(grep -s '^APP_IMAGE=' "$STACK/.env" || true)

read_secret() {
  gcloud secrets versions access latest --secret="$PREFIX-$1" --project="$PROJECT_ID"
}

read_optional_secret() {
  gcloud secrets versions access latest --secret="$PREFIX-$1" --project="$PROJECT_ID" 2>/dev/null || true
}

cd "$STACK"

umask 077
{
  echo "POSTGRES_PASSWORD=$(read_secret postgres-password)"
  echo "APP_DB_PASSWORD=$(read_secret app-db-password)"
  echo "WORKER_DB_PASSWORD=$(read_secret worker-db-password)"
  echo "DATABASE_URL=$(read_secret database-url)"
  echo "TRIA_WORKER_TOKEN=$(read_secret worker-token)"
  echo "TRIA_SESSION_SECRET=$(read_secret session-secret)"
  echo "N8N_ENCRYPTION_KEY=$(read_secret n8n-encryption-key)"
  echo "N8N_API_URL=http://n8n:5678"
  echo "N8N_PUBLIC_URL=$(test -n "$N8N_HOST" && echo "https://$N8N_HOST" || echo "")"
  echo "N8N_API_KEY=$(read_optional_secret n8n-api-key)"
  echo "N8N_OWNER_EMAIL=$(read_optional_secret n8n-owner-email)"
  echo "N8N_OWNER_PASSWORD=$(read_optional_secret n8n-owner-password)"
  echo "N8N_DB_PASSWORD=$(read_secret n8n-db-password)"
  echo "PROXY_BASIC_AUTH=$(read_secret proxy-basic-auth | sed 's/\$/$$/g')"
  echo "TRIA_APP_BASE_URL=https://$APP_HOST"
  echo "APP_HOST=$APP_HOST"
  echo "N8N_HOST=$N8N_HOST"
  echo "N8N_PROTOCOL=$(test -n "$N8N_HOST" && echo https || echo http)"
  echo "N8N_SECURE_COOKIE=$(test -n "$N8N_HOST" && echo true || echo false)"
  echo "N8N_WEBHOOK_URL=$(test -n "$N8N_HOST" && echo "https://$N8N_HOST/" || echo "http://localhost:5678/")"
  echo "ACME_EMAIL=$ACME_EMAIL"
  echo "BQ_PROJECT_ID=$PROJECT_ID"
  echo "BQ_DATASET=tria_dw"
  echo "GOOGLE_OAUTH_CLIENT_ID=$(read_optional_secret google-oauth-client-id)"
  echo "GOOGLE_OAUTH_CLIENT_SECRET=$(read_optional_secret google-oauth-client-secret)"
  echo "META_APP_ID=$(read_optional_secret meta-app-id)"
  echo "META_APP_SECRET=$(read_optional_secret meta-app-secret)"
  echo "META_LOGIN_CONFIG_ID=$(read_optional_secret meta-login-config-id)"
  echo "RDSTATION_CLIENT_ID=$(read_optional_secret rdstation-client-id)"
  echo "RDSTATION_CLIENT_SECRET=$(read_optional_secret rdstation-client-secret)"
  echo "WHATSAPP_LOGIN_CONFIG_ID=$(read_optional_secret whatsapp-login-config-id)"
  echo "WHATSAPP_WEBHOOK_VERIFY_TOKEN=$(read_optional_secret whatsapp-webhook-verify-token)"
} > .env
if [ -n "$IMAGEM_ATUAL" ]; then echo "$IMAGEM_ATUAL" >> .env; fi
chmod 600 .env

readonly DISCO_DADOS=/dev/disk/by-id/google-dados
readonly DADOS=/srv/dados
readonly VOLUMES=/var/lib/docker/volumes

particao_dados() {
  if [ -e "$DISCO_DADOS-part1" ]; then echo "$DISCO_DADOS-part1"; else echo "$DISCO_DADOS"; fi
}

montar_disco_dados() {
  udevadm settle
  local particao
  particao=$(particao_dados)

  if ! mountpoint -q "$DADOS"; then
    if ! blkid "$particao" > /dev/null 2>&1; then
      mkfs.ext4 -F "$particao"
    fi
    e2fsck -fy "$particao" || [ $? -le 2 ]
    mkdir -p "$DADOS"
    mount -o defaults,discard "$particao" "$DADOS"
  fi

  mkdir -p "$DADOS$VOLUMES" "$VOLUMES"
  if ! mountpoint -q "$VOLUMES"; then
    mount --bind "$DADOS$VOLUMES" "$VOLUMES"
  fi

  grep -qF " $DADOS " /etc/fstab \
    || echo "$particao $DADOS ext4 defaults,discard,nofail 0 2" >> /etc/fstab
  grep -qF " $VOLUMES " /etc/fstab \
    || echo "$DADOS$VOLUMES $VOLUMES none bind,nofail,x-systemd.requires-mounts-for=$DADOS 0 0" >> /etc/fstab

  mkdir -p /etc/systemd/system/docker.service.d
  printf '[Unit]\nRequiresMountsFor=%s\n' "$VOLUMES" > /etc/systemd/system/docker.service.d/dados.conf
  systemctl daemon-reload
}

montar_disco_dados

configurar_limpeza() {
  mkdir -p /etc/systemd/journald.conf.d
  printf '[Journal]\nSystemMaxUse=200M\nMaxRetentionSec=1month\n' > /etc/systemd/journald.conf.d/tria.conf
  systemctl restart systemd-journald

  cat > /etc/systemd/system/tria-limpeza.service <<'UNIDADE'
[Unit]
Description=Limpeza semanal de imagens, cache e pacotes sem uso
ConditionPathExists=/usr/bin/docker

[Service]
Type=oneshot
ExecStart=/usr/bin/docker image prune -af
ExecStart=/usr/bin/docker builder prune -af --filter until=168h
ExecStart=/usr/bin/docker container prune -f --filter until=168h
ExecStart=/usr/bin/apt-get clean
UNIDADE

  cat > /etc/systemd/system/tria-limpeza.timer <<'UNIDADE'
[Unit]
Description=Agenda a limpeza semanal

[Timer]
OnCalendar=Sun 04:00
Persistent=true

[Install]
WantedBy=timers.target
UNIDADE

  systemctl daemon-reload
  systemctl enable --now tria-limpeza.timer
}

configurar_limpeza

if [ -f /var/lib/tria-provisioned ]; then
  echo "Ja provisionado. Ambiente regravado a partir dos segredos. Subindo a pilha."
  cd "$STACK" && docker compose -f docker-compose.prod.yml up -d
  exit 0
fi

apt-get update
apt-get install -y ca-certificates curl gnupg

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg -o /tmp/docker.asc
gpg --batch --yes --dearmor -o /etc/apt/keyrings/docker.gpg /tmp/docker.asc
rm -f /tmp/docker.asc
chmod a+r /etc/apt/keyrings/docker.gpg

ARCH=$(dpkg --print-architecture)
CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $CODENAME stable" > /etc/apt/sources.list.d/docker.list

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin

if ! swapon --show=NAME --noheadings | grep -qx /swapfile; then
  rm -f /swapfile
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
fi
grep -qxF "/swapfile none swap sw 0 0" /etc/fstab || echo "/swapfile none swap sw 0 0" >> /etc/fstab
sysctl -w vm.swappiness=10
echo "vm.swappiness=10" > /etc/sysctl.d/99-tria.conf


touch /var/lib/tria-provisioned
echo "Base pronta. O compose e o Caddyfile chegam pelo deploy."
