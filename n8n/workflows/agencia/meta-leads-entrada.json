      "name": "Separar leads e escolher cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const CLIENTES = {\n  '1000117996519094': { cliente: 'credaz', workflowId: 'TkrchseIkpszaY1D' }\n};\nconst saida = [];\nfor (const corpo of [$('Corpo bruto').first().json.body || {}]) {\n  for (const entrada of corpo.entry || []) {\n    for (const mudanca of entrada.changes || []) {\n      if (mudanca.field !== 'leadgen') continue;\n      const valor = mudanca.value || {};\n      const pageId = String(valor.page_id || entrada.id || '');\n      const destino = CLIENTES[pageId];\n      saida.push({\n        json: {\n          leadgen_id: String(valor.leadgen_id || ''),\n          page_id: pageId,\n          form_id: String(valor.form_id || ''),\n          ad_id: String(valor.ad_id || ''),\n          origem: 'webhook',\n          cliente: destino ? destino.cliente : 'desconhecido',\n          workflowId: destino ? destino.workflowId : ''\n        }\n      });\n    }\n  }\n}\nconst soDigitos = (valor) => /^\\d+$/.test(valor);\nreturn saida.filter((item) => soDigitos(item.json.leadgen_id) && soDigitos(item.json.page_id) && (item.json.form_id === '' || soDigitos(item.json.form_id)));"
      }
    },
