    {
      "id": "montar-negociacao",
      "name": "Montar negociação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -80
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $json;\nconst campos = Object.fromEntries((lead.field_data || []).map((campo) => [campo.name, (campo.values || [])[0]]));\nconst pegar = (...chaves) => {\n  for (const chave of chaves) {\n    const valor = campos[chave];\n    if (valor !== undefined && valor !== null && String(valor).trim() !== '') return String(valor).trim();\n  }\n  return '';\n};\nconst PRODUTOS = {\n  consignado_inss: { nome: 'Consignado INSS', id: '6afe1dcd60a635001dd87b0d' },\n  consignado_clt: { nome: 'Consignado CLT', id: '6afe1e0d7d2654001dbc1d82' },\n  antecipacao_fgts: { nome: 'Antecipação FGTS', id: '6afe1ddffcccaf001f5331ff' },\n  bolsa_familia: { nome: 'Empréstimo Bolsa Família', id: '6afe1e18b69550001ff07293' },\n  conta_de_energia: { nome: 'Crédito na conta de energia (Celpe)', id: '6afe1e2214058c001fa1b07c' },\n  emprestimo_pessoal: { nome: 'Empréstimo pessoal', id: '6afe1e2c60a6350021d87d54' },\n  cartao_de_credito: { nome: 'Empréstimo no cartão de crédito', id: '6afe1e378558d70022a630d7' }\n};\nconst normalizarTelefone = (bruto) => {\n  const digitos = String(bruto || '').replace(/\\D/g, '');\n  if (!digitos) return String(bruto || '').trim();\n  if (digitos.length === 10 || digitos.length === 11) return `+55${digitos}`;\n  if ((digitos.length === 12 || digitos.length === 13) && digitos.startsWith('55')) return `+${digitos}`;\n  return String(bruto).trim();\n};\nconst nome = pegar('nome_completo', 'full_name', 'nome') || 'Lead Meta';\nconst telefone = normalizarTelefone(pegar('telefone', 'phone_number', 'whatsapp'));\nconst email = pegar('email');\nconst codigoProduto = pegar('produto');\nconst produto = PRODUTOS[codigoProduto] || Object.values(PRODUTOS).find((p) => p.nome === codigoProduto) || null;\nconst nomeProduto = produto ? produto.nome : codigoProduto;\nconst leadId = String(lead.id || '');\nconst camposPersonalizados = [\n  { custom_field_id: '6afe21ef2fbf58001fcfc746', value: leadId },\n  { custom_field_id: '6afe22183d2fa7001f66c56c', value: lead.campaign_name || '' },\n  { custom_field_id: '6afe222b525dfe001d864664', value: lead.ad_name || '' }\n].filter((campo) => campo.value);\nconst contato = { name: nome };\nif (telefone) contato.phones = [{ phone: telefone, type: 'cellphone' }];\nif (email) contato.emails = [{ email }];\nreturn {\n  json: {\n    leadId,\n    produtoId: produto ? produto.id : '',\n    body: {\n      deal: {\n        name: nomeProduto ? `${nome} · ${nomeProduto}` : nome,\n        deal_stage_id: '6afe1d632fbf58001fcfc512',\n        deal_custom_fields: camposPersonalizados\n      },\n      contacts: [contato],\n      deal_source: { _id: '6afe1e7f7d2654001dbc1dc1' }\n    }\n  }\n};"
      }
    },
