      "name": "Ler aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const corpo = $input.first().json.body || {};\nconst documento = corpo.document || corpo.deal || {};\nconst dealId = String(documento.id || documento._id || '');\nif (!/^[0-9a-f]{24}$/.test(dealId)) return [];\nreturn [{ json: { deal_id: dealId, evento: String(corpo.event_name || '') } }];"
      }
    },
