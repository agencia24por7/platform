    {
      "id": "escolher-tarefa",
      "name": "Escolher tarefa da etapa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const negociacao = $input.first().json;\nconst ETAPAS = {\n  '6afe1d632fbf58001fcfc512': { assunto: 'Fazer o primeiro contato e confirmar o canal', tipo: 'call' },\n  '6afe1d632fbf58001fcfc513': { assunto: 'Definir o produto de interesse', tipo: 'whatsapp' },\n  '6afe1d632fbf58001fcfc514': { assunto: 'Analisar o crédito (se houver problema, acionar o grupo de apoio no WhatsApp)', tipo: 'task' },\n  '6afe1d632fbf58001fcfc515': { assunto: 'Apresentar as condições comerciais e obter o aceite', tipo: 'whatsapp' },\n  '6afe1d632fbf58001fcfc516': { assunto: 'Coletar os dados e documentos do cliente', tipo: 'whatsapp' },\n  '6afe242c643baa001fed117b': { assunto: 'Enviar a proposta ao banco e acompanhar a liberação', tipo: 'task' },\n  '6afe3f78712e04001dd6f435': { assunto: 'Confirmar a liberação, preencher o valor liberado e marcar a venda', tipo: 'task' }\n};\nconst encerrada = negociacao.win === true || negociacao.win === false || Boolean(negociacao.closed_at);\nconst etapaId = String((negociacao.deal_stage || {}).id || (negociacao.deal_stage || {})._id || '');\nconst tarefa = ETAPAS[etapaId];\nif (encerrada || !tarefa) return [];\nconst agora = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Recife' }));\nconst prazo = new Date(agora.getTime() + 2 * 60 * 60 * 1000);\nif (prazo.getHours() >= 18 || prazo.getDate() !== agora.getDate()) {\n  prazo.setDate(agora.getDate() + 1);\n  prazo.setHours(9, 0, 0, 0);\n}\nconst doisDigitos = (n) => String(n).padStart(2, '0');\nreturn [{\n  json: {\n    deal_id: String(negociacao.id || negociacao._id),\n    etapa_id: etapaId,\n    body: {\n      task: {\n        deal_id: String(negociacao.id || negociacao._id),\n        user_ids: [String((negociacao.user || {}).id || (negociacao.user || {})._id || '')].filter(Boolean),\n        subject: tarefa.assunto,\n        type: tarefa.tipo,\n        date: `${prazo.getFullYear()}-${doisDigitos(prazo.getMonth() + 1)}-${doisDigitos(prazo.getDate())}`,\n        hour: `${doisDigitos(prazo.getHours())}:${doisDigitos(prazo.getMinutes())}`\n      }\n    }\n  }\n}];"
      }
    },
