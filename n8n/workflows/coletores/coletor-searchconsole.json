    {
      "id": "normalizar",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const contexto = $('Montar requisição').first().json;\nconst TABELAS = [\"padrao\",\"consulta_pagina\",\"pagina\",\"pais_dispositivo\",\"aparencia\"];\nconst coletadas = TABELAS.map((tabela) => ({\n  consulta: contexto.consultas[tabela],\n  respostas: $(`Fechar ${tabela}`).first().json.respostas,\n}));\nconst respostas = coletadas.flatMap((item) => item.respostas);\nconst requests = respostas.length;\nconst bytes = respostas.reduce((total, resposta) => total + JSON.stringify(resposta.body ?? {}).length, 0);\n\nfunction devolver(linhas, falhas) {\n  return [{\n    json: {\n      linhas,\n      volumetria: { linhas: linhas.length, bytes, requests, duracaoMs: Date.now() - contexto.inicio },\n      falhas,\n      requests,\n      versaoApi: contexto.versaoApi,\n    },\n  }];\n}\n\nconst falhaDeRede = respostas.find((resposta) => resposta.error);\nif (falhaDeRede) {\n  const detalhe = falhaDeRede.error?.message ?? String(falhaDeRede.error);\n  return devolver([], [{ causa: 'api_recusou', detalhe: `falha de rede: ${detalhe}`.slice(0, 500) }]);\n}\n\nconst aceita = (consulta, resposta) => resposta.statusCode >= 200 && resposta.statusCode < 300 || (consulta.opcional && resposta.statusCode === 400);\nconst recusada = coletadas.flatMap((item) => item.respostas.map((resposta) => ({ consulta: item.consulta, resposta }))).find((par) => !aceita(par.consulta, par.resposta))?.resposta;\nif (recusada) {\n  const erro = Array.isArray(recusada.body) ? recusada.body[0]?.error : recusada.body?.error;\n  const detalhe = String(erro?.message || `HTTP ${recusada.statusCode}`).slice(0, 500);\n  const configuracaoDoProjeto = recusada.statusCode === 429 || /SERVICE_DISABLED|accessNotConfigured|has not been used in project|RESOURCE_EXHAUSTED|RATE_LIMIT/.test(JSON.stringify(erro ?? {}));\n  const semAcesso = !configuracaoDoProjeto && (recusada.statusCode === 401 || recusada.statusCode === 403 || erro?.code === 190);\n  return devolver([], [{ causa: semAcesso ? 'reauth_pending' : 'api_recusou', detalhe }]);\n}\n\nconst motivoDaRecusa = (resposta) => {\n  if (resposta?.error) return `falha de rede: ${resposta.error?.message ?? String(resposta.error)}`;\n  const erro = Array.isArray(resposta?.body) ? resposta.body[0]?.error : resposta?.body?.error;\n  return String(erro?.message || `HTTP ${resposta?.statusCode}`);\n};\n\nfunction coletaIncompleta(recusas) {\n  const porTabela = new Map();\n  for (const { tabela, resposta } of recusas) {\n    const atual = porTabela.get(tabela) ?? { total: 0, motivo: motivoDaRecusa(resposta) };\n    porTabela.set(tabela, { ...atual, total: atual.total + 1 });\n  }\n  return [...porTabela].map(([tabela, { total, motivo }]) => ({\n    causa: 'coleta_incompleta',\n    detalhe: `${tabela}: ${total > 1 ? `${total} pedidos recusados, ` : ''}${motivo}`.slice(0, 500),\n  }));\n}\n\nconst incompletas = coletaIncompleta(coletadas.flatMap(({ consulta, respostas: paginas }) => paginas\n  .filter((resposta) => !(resposta.statusCode >= 200 && resposta.statusCode < 300))\n  .map((resposta) => ({ tabela: consulta.tabela, resposta }))));\n\nconst linhas = coletadas.flatMap(({ consulta, respostas: paginas }) => paginas\n  .filter((resposta) => resposta.statusCode >= 200 && resposta.statusCode < 300)\n  .flatMap((resposta) => resposta.body?.rows ?? [])\n  .map((linha) => {\n    const saida = consulta.tabela === 'padrao' ? {} : { _tabela: consulta.tabela };\n    consulta.dimensoes.forEach(([, campo], indice) => {\n      saida[campo] = linha.keys?.[indice] ?? null;\n    });\n    saida[consulta.metricas[0]] = Number(linha.clicks ?? 0);\n    saida[consulta.metricas[1]] = Number(linha.impressions ?? 0);\n    saida[consulta.metricas[2]] = Number(linha.ctr ?? 0);\n    saida[consulta.metricas[3]] = Number(linha.position ?? 0);\n    return saida;\n  }));\n\nif (linhas.length === 0) return devolver([], incompletas.length > 0 ? incompletas : [{ causa: 'sem_dados_no_periodo', detalhe: null }]);\nreturn devolver(linhas.map((linha) => ({ ...linha, versaoApi: contexto.versaoApi })), incompletas);\n"
      }
    }
