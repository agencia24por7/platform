        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { fonte, janela, modo } = $json;\nconst versaoApi = 'v3';\nconst limite = modo === 'amostra' ? 500 : 25000;\nconst URL_DA_CONSULTA = `https://www.googleapis.com/webmasters/${versaoApi}/sites/${encodeURIComponent(fonte.externalId)}/searchAnalytics/query`;\n\nconst METRICAS_ANTIGAS = ['clicks', 'impressions', 'ctr', 'position'];\nconst METRICAS = ['cliques', 'impressoes', 'ctr', 'posicao_media'];\n\nconst RECORTES = {\n  padrao: { opcional: false, dimensoes: [['date', 'metricDate'], ['device', 'device']], metricas: METRICAS_ANTIGAS },\n  consulta_pagina: { opcional: false, dimensoes: [['date', 'metricDate'], ['query', 'consulta'], ['page', 'pagina']], metricas: METRICAS },\n  pagina: { opcional: false, dimensoes: [['date', 'metricDate'], ['page', 'pagina']], metricas: METRICAS },\n  pais_dispositivo: { opcional: false, dimensoes: [['date', 'metricDate'], ['country', 'pais'], ['device', 'dispositivo']], metricas: METRICAS },\n  aparencia: { opcional: true, dimensoes: [['date', 'metricDate'], ['searchAppearance', 'aparencia']], metricas: METRICAS },\n};\n\nconst consultas = Object.fromEntries(Object.entries(RECORTES).map(([tabela, recorte]) => [tabela, {\n  tabela,\n  ...recorte,\n  corpo: {\n    startDate: janela.start,\n    endDate: janela.end,\n    dimensions: recorte.dimensoes.map(([nome]) => nome),\n    rowLimit: limite,\n    startRow: 0,\n    dataState: 'final',\n  },\n}]));\n\nreturn [{ json: { inicio: Date.now(), versaoApi, fonte, url: URL_DA_CONSULTA, consultas } }];\n"
      }
    },
