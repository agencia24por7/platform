            "index": 0
          }
        ]
      ]
    },
    "Uma tarefa por item": {
      "main": [
        [
          {
            "node": "Processar em série",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Processar em série": {
      "main": [
        [],
        [
          {
            "node": "Convidar conta na MCC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Convidar conta na MCC": {
      "main": [
        [
          {
            "node": "Reportar resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reportar resultado": {
      "main": [
        [
          {
