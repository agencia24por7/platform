        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "googleOAuth2Api": {
          "id": "a-definir-pelo-provisioner",
          "name": "a-definir-pelo-provisioner"
        }
      },
