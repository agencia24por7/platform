    {
      "id": "achar",
      "name": "Achar vínculo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const plano = $('Planejar').first().json;\nconst resposta = $input.first().json;\n\nif (resposta.error) return [{ json: { falha: `falha de rede: ${resposta.error?.message ?? resposta.error}` } }];\nif (!(resposta.statusCode >= 200 && resposta.statusCode < 300)) {\n  return [{ json: { falha: `não foi possível listar convites pendentes (HTTP ${resposta.statusCode})` } }];\n}\n\nconst vinculo = (resposta.body?.results ?? []).find((linha) =>\n  String(linha?.customerManagerLink?.managerCustomer ?? '').endsWith(`/${plano.administradora}`),\n);\nif (!vinculo) return [{ json: { falha: 'nenhum convite pendente desta administradora nesta conta' } }];\n\nreturn [{\n  json: {\n    url: `https://googleads.googleapis.com/v26/customers/${plano.convidada}/customerManagerLinks:mutate`,\n    loginCustomerId: plano.convidada,\n    corpo: {\n      validateOnly: plano.validar,\n      operations: [{ update: { resourceName: vinculo.customerManagerLink.resourceName, status: 'ACTIVE' }, updateMask: 'status' }],\n    },\n  },\n}];\n"
      }
    },
    {
      "id": "achou",
      "name": "Achou?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
