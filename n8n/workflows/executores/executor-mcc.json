      },
      "credentials": {
        "googleOAuth2Api": {
          "id": "a-definir-pelo-provisioner",
          "name": "a-definir-pelo-provisioner"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
