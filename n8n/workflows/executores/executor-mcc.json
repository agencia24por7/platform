{
  "name": "Executor · tarefas da MCC (modelo)",
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "timezone": "America/Sao_Paulo",
    "saveManualExecutions": false
  },
  "nodes": [
    {
      "id": "entrada",
      "name": "Entrada",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "tarefa"
            },
            {
              "name": "validarSomente"
            }
          ]
        }
      }
    },
    {
      "id": "planejar",
      "name": "Planejar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { tarefa } = $json;\nconst validar = $json.validarSomente === true || $json.validarSomente === 'true';\nconst base = 'https://googleads.googleapis.com/v26/customers';\nconst administradora = String(tarefa?.managerExternalId || '').replace(/\\D/g, '');\nconst convidada = String(tarefa?.targetExternalId || '').replace(/\\D/g, '');\n\nif (!tarefa?.taskId) return [{ json: { tarefa: tarefa ?? {}, validar, falha: 'tarefa sem identificador' } }];\nif (!administradora || !convidada) return [{ json: { tarefa, validar, falha: 'identificadores ausentes na tarefa' } }];\n\nif (tarefa.kind === 'mcc_invite') {\n  return [{\n    json: {\n      tarefa,\n      validar,\n      acao: 'convidar',\n      url: `${base}/${administradora}/customerClientLinks:mutate`,\n      loginCustomerId: administradora,\n      corpo: { validateOnly: validar, operation: { create: { clientCustomer: `customers/${convidada}`, status: 'PENDING' } } },\n    },\n  }];\n}\n\nif (tarefa.kind === 'mcc_accept') {\n  return [{\n    json: {\n      tarefa,\n      validar,\n      acao: 'aceitar',\n      administradora,\n      convidada,\n      url: `${base}/${convidada}/googleAds:search`,\n      loginCustomerId: convidada,\n      corpo: {\n        query: \"SELECT customer_manager_link.resource_name, customer_manager_link.manager_customer, customer_manager_link.status FROM customer_manager_link WHERE customer_manager_link.status = 'PENDING'\",\n      },\n    },\n  }];\n}\n\nreturn [{ json: { tarefa, validar, falha: `tipo de tarefa desconhecido: ${tarefa.kind}` } }];\n"
      }
    },
    {
      "id": "pode-chamar",
      "name": "Pode chamar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "pode-chamar-c",
              "leftValue": "={{ !$json.falha }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
