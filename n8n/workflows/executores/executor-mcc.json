    {
      "id": "normalizar",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const plano = $('Planejar').first().json;\nconst atual = $input.first().json;\nconst taskId = plano.tarefa?.taskId ?? null;\nconst recusar = (motivo) => [{ json: { taskId, sucesso: false, outcome: String(motivo).slice(0, 500) } }];\n\nif (plano.falha) return recusar(plano.falha);\nif (atual.falha) return recusar(atual.falha);\nif (atual.error) return recusar(`falha de rede: ${atual.error?.message ?? atual.error}`);\n\nif (atual.statusCode >= 200 && atual.statusCode < 300) {\n  const recurso = atual.body?.result?.resourceName ?? atual.body?.results?.[0]?.resourceName ?? (plano.validar ? 'nada gravado' : 'concluído');\n  const rotulo = plano.acao === 'convidar' ? 'convite pendente' : 'vínculo ativo';\n  return [{ json: { taskId, sucesso: true, outcome: `${plano.validar ? '[só validação] ' : ''}${rotulo} · ${recurso}`.slice(0, 500) } }];\n}\n\nconst erro = atual.body?.error ?? (Array.isArray(atual.body) ? atual.body[0]?.error : null);\nconst detalhe = erro?.details?.[0]?.errors?.[0];\nconst codigo = detalhe ? Object.values(detalhe.errorCode ?? {})[0] : null;\nconst mensagem = detalhe?.message || erro?.message || 'recusado sem mensagem';\nreturn recusar(`${codigo ? `${codigo} · ` : ''}${mensagem} (HTTP ${atual.statusCode})`);\n"
      }
    }
  ],
