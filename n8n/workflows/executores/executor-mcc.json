            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "e-convite-c",
              "leftValue": "={{ $json.acao === 'convidar' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
