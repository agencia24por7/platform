    {
      "id": "obter-token",
      "name": "Obter token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        -200
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://app:3000/api/v0/coleta/token",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tarefaId: $('Entrada').first().json.tarefa?.taskId ?? $('Entrada').first().json.tarefaId }) }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "a-definir-pelo-provisioner",
          "name": "ORLA · worker token"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "token-obtido",
      "name": "Token obtido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        -200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "token-obtido-c",
              "leftValue": "={{ $json.statusCode === 200 && typeof $json.body?.token === 'string' && $json.body.token.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "retomar-entrada",
      "name": "Retomar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        -300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $('Entrada').all().map((item) => ({ json: item.json }));\n"
      }
    },
    {
      "id": "sem-token",
      "name": "Sem token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const resposta = $('Obter token').first().json ?? {};\nconst tarefa = $('Entrada').first().json.tarefa ?? {};\nconst status = Number(resposta.statusCode ?? 0);\nconst motivo = String(resposta.body?.errors?.motivo ?? '');\nconst PEDE_REAUTORIZACAO = new Set(['reauth_pending', 'sem_token', 'conexao_revogada']);\n\nconst outcome = status === 409 && PEDE_REAUTORIZACAO.has(motivo)\n  ? `reauth_pending: a conexão não tem token válido no cofre (${motivo}); reautorize e peça de novo`\n  : `cofre de tokens recusou o pedido (HTTP ${status || 'sem resposta'}${motivo ? `, ${motivo}` : ''})`;\n\nreturn [{ json: { taskId: tarefa.taskId ?? null, sucesso: false, outcome: outcome.slice(0, 500) } }];\n"
      }
    },
    {
      "id": "planejar",
      "name": "Planejar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { tarefa } = $json;\nconst validar = $json.validarSomente === true || $json.validarSomente === 'true';\nconst VERSAO_DA_API_META = 'v27.0';\nconst versao = VERSAO_DA_API_META;\nconst TAREFAS_PEDIDAS = ['ANALYZE'];\nconst negocio = String(tarefa?.managerExternalId ?? '').trim();\nconst conta = String(tarefa?.targetExternalId ?? '').trim().toLowerCase();\n\nconst recusar = (falha) => [{ json: { tarefa: tarefa ?? {}, validar, falha } }];\nif (!tarefa?.taskId) return recusar('tarefa sem identificador');\nif (tarefa.kind !== 'bm_partner_request') return recusar(`tipo de tarefa desconhecido: ${tarefa.kind}`);\nif (!/^\\d{5,25}$/.test(negocio)) return recusar('Business Manager da agência ausente ou fora do formato numérico');\nif (!/^act_\\d{4,20}$/.test(conta)) return recusar('conta de anúncio fora do formato act_1234567890');\n\nif (validar) {\n  return [{ json: { tarefa, validar, conta, permitidas: TAREFAS_PEDIDAS, url: `https://graph.facebook.com/${versao}/${negocio}?fields=id,name,verification_status` } }];\n}\n\nreturn [{\n  json: {\n    tarefa,\n    validar,\n    conta,\n    permitidas: TAREFAS_PEDIDAS,\n    url: `https://graph.facebook.com/${versao}/${negocio}/client_ad_accounts`,\n  },\n}];\n"
      }
    },
    {
      "id": "pode-chamar",
      "name": "Pode chamar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "pode-chamar-c",
              "leftValue": "={{ !$json.falha }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "so-validar",
      "name": "Só validar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "so-validar-c",
              "leftValue": "={{ $json.validar === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "conferir-bm",
      "name": "Conferir Business Manager",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Obter token').first().json.body.token }}"
            }
          ]
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "pedir-acesso",
      "name": "Pedir acesso à conta do cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "adaccount_id",
              "value": "={{ $json.conta }}"
            },
            {
              "name": "permitted_tasks",
              "value": "={{ JSON.stringify($json.permitidas) }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Obter token').first().json.body.token }}"
            }
          ]
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "normalizar",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const plano = $('Planejar').first().json;\nconst atual = $input.first().json;\nconst taskId = plano.tarefa?.taskId ?? null;\nconst recusar = (motivo) => [{ json: { taskId, sucesso: false, outcome: String(motivo).slice(0, 500) } }];\n\nif (plano.falha) return recusar(plano.falha);\nif (atual.error) return recusar(`falha de rede: ${atual.error?.message ?? atual.error}`);\n\nif (atual.statusCode >= 200 && atual.statusCode < 300) {\n  if (plano.validar) {\n    const nome = atual.body?.name ?? atual.body?.id ?? 'sem nome';\n    return [{ json: { taskId, sucesso: true, outcome: `[só validação] Business Manager acessível · ${nome} · pediria ${plano.permitidas.join(',')} em ${plano.conta}`.slice(0, 500) } }];\n  }\n  const situacao = atual.body?.access_status ?? (atual.body?.success === true ? 'PENDING' : 'desconhecida');\n  const outcome = situacao === 'CONFIRMED'\n    ? `acesso confirmado · ${plano.conta} · ${plano.permitidas.join(',')}`\n    : `pedido enviado · ${plano.conta} · ${plano.permitidas.join(',')} · aguardando aprovação do cliente no Business Manager dele (${situacao})`;\n  return [{ json: { taskId, sucesso: true, outcome: outcome.slice(0, 500) } }];\n}\n\nconst erro = atual.body?.error ?? {};\nif (erro.code === 190) return recusar('credencial da Meta expirada ou revogada: reautorize o Meta Ads (código 190)');\nconst titulo = erro.error_user_title || erro.message || 'recusado sem mensagem';\nconst codigo = erro.code ? ` (código ${erro.code}${erro.error_subcode ? `/${erro.error_subcode}` : ''})` : '';\nreturn recusar(`${titulo}${codigo} · HTTP ${atual.statusCode}`);\n"
      }
    }
  ],
