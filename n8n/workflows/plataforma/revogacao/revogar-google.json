{
  "name": "ORLA · revogação · Google (modelo)",
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "callerPolicy": "workflowsFromSameOwner",
    "timezone": "America/Sao_Paulo"
  },
  "nodes": [
    {
      "id": "entrada",
      "name": "Entrada",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "parameters": {
        "workflowInputs": {
          "values": [{ "name": "connectionId" }]
        }
      }
    },
    {
      "id": "revogar-no-google",
      "name": "Revogar no Google",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/orla-revogar-google-portador",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ connectionId: $json.connectionId }) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "googleOAuth2Api": {
          "id": "a-definir-pelo-provisioner",
          "name": "a-definir-pelo-provisioner"
        }
      }
    },
    {
      "id": "resultado",
      "name": "Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0],
      "parameters": {
        "jsCode": "const resposta = $input.first().json;\nconst status = typeof resposta.statusCode === 'number' ? resposta.statusCode : null;\nreturn [{ json: { revogado: status === 200 && resposta.body?.revogado === true, status } }];"
      }
    }
  ],
  "connections": {
    "Entrada": { "main": [[{ "node": "Revogar no Google", "type": "main", "index": 0 }]] },
    "Revogar no Google": { "main": [[{ "node": "Resultado", "type": "main", "index": 0 }]] }
  }
}
