{
  "name": "ORLA · privacidade · revogar acesso no provedor",
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "timezone": "America/Sao_Paulo"
  },
  "nodes": [
    {
      "id": "pedido",
      "name": "Pedido de revogação",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "orla-revogar-acesso",
      "parameters": {
        "httpMethod": "POST",
        "path": "orla-revogar-acesso",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "responseData": "firstEntryJson",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "a-definir-pelo-provisioner",
          "name": "ORLA · worker token"
        }
      }
    },
    {
      "id": "validar",
      "name": "Validar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "jsCode": "const corpo = $input.first().json.body ?? {};\nconst workflowId = String(corpo.workflowId ?? '');\nconst connectionId = String(corpo.connectionId ?? '');\nif (!/^[A-Za-z0-9]{8,32}$/.test(workflowId)) throw new Error('workflowId inválido');\nif (!/^[0-9a-f-]{36}$/i.test(connectionId)) throw new Error('connectionId inválido');\nreturn [{ json: { workflowId, connectionId } }];"
      }
    },
    {
      "id": "executar",
      "name": "Executar revogação da conexão",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [440, 0],
      "onError": "continueRegularOutput",
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "={{ $json.workflowId }}",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "connectionId": "={{ $json.connectionId }}"
          }
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "responder",
      "name": "Responder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "jsCode": "const saida = $input.first().json;\nreturn [{ json: { revogado: saida.revogado === true, status: typeof saida.status === 'number' ? saida.status : null } }];"
      }
    },
    {
      "id": "portador",
      "name": "Portador do Google",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "orla-revogar-google-portador",
      "parameters": {
        "httpMethod": "POST",
        "path": "orla-revogar-google-portador",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "revogar-com-o-portador",
      "name": "Revogar com o portador",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 300],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/revoke",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ String($json.headers?.authorization ?? '').replace(/^Bearer\\s+/i, '') }}"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "responder-ao-portador",
      "name": "Responder ao portador",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ revogado: $json.statusCode === 200 }) }}",
        "options": {
          "responseCode": "={{ $json.statusCode === 200 ? 200 : ($json.body?.error === 'invalid_token' ? 401 : 502) }}"
        }
      }
    }
  ],
  "connections": {
    "Pedido de revogação": { "main": [[{ "node": "Validar pedido", "type": "main", "index": 0 }]] },
    "Validar pedido": { "main": [[{ "node": "Executar revogação da conexão", "type": "main", "index": 0 }]] },
    "Executar revogação da conexão": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] },
    "Portador do Google": { "main": [[{ "node": "Revogar com o portador", "type": "main", "index": 0 }]] },
    "Revogar com o portador": { "main": [[{ "node": "Responder ao portador", "type": "main", "index": 0 }]] }
  }
}
