{
  "name": "ORLA · tarefas de conta",
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "timezone": "America/Sao_Paulo"
  },
  "nodes": [
    {
      "id": "gatilho-minuto",
      "name": "A cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -640,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "gatilho-manual",
      "name": "Execução manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -640,
        180
      ],
      "parameters": {}
    },
    {
      "id": "ler-fila",
      "name": "Ler fila de tarefas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        80
      ],
      "parameters": {
        "url": "=http://app:3000/api/v0/tasks/queue?limit=10&kinds=mcc_invite,mcc_accept,bm_partner_request",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "triaWorkerAuth",
          "name": "ORLA · token do worker"
        }
      }
    },
    {
      "id": "uma-tarefa",
      "name": "Uma tarefa por item",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -200,
        80
      ],
      "parameters": {
        "fieldToSplitOut": "tasks",
        "options": {}
      }
    },
    {
      "id": "em-serie",
      "name": "Processar em série",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        20,
        80
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "tem-executor",
      "name": "Tem executor?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "tem-executor-c",
              "leftValue": "={{ Boolean($json.executorRef) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "executar",
      "name": "Executar tarefa",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "={{ $json.executorRef }}",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "tarefa": "={{ $json }}",
            "validarSomente": "={{ false }}"
          }
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "resultado",
      "name": "Conferir resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const tarefa = $('Processar em série').item.json;\nconst saida = $json ?? {};\nif (saida.taskId && typeof saida.sucesso === 'boolean') return { json: saida };\nconst motivo = saida.error?.message ?? saida.error ?? 'executor não devolveu resultado';\nreturn { json: { taskId: tarefa.taskId, sucesso: false, outcome: `falha no executor: ${motivo}`.slice(0, 500) } };\n"
      }
    },
    {
      "id": "sem-executor",
      "name": "Sem executor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\n  json: {\n    taskId: $json.taskId,\n    sucesso: false,\n    outcome: 'conexão sem executor provisionado: reautorize a conexão para criar o executor',\n  },\n};\n"
      }
    },
    {
      "id": "reportar",
      "name": "Reportar resultado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://app:3000/api/v0/tasks/result",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ taskId: $json.taskId, sucesso: $json.sucesso, outcome: $json.outcome }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "triaWorkerAuth",
          "name": "ORLA · token do worker"
        }
      }
    }
  ],
  "connections": {
    "A cada 5 minutos": {
      "main": [
        [
          {
            "node": "Ler fila de tarefas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execução manual": {
      "main": [
        [
          {
            "node": "Ler fila de tarefas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ler fila de tarefas": {
      "main": [
        [
          {
            "node": "Uma tarefa por item",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Uma tarefa por item": {
      "main": [
        [
          {
            "node": "Processar em série",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Processar em série": {
      "main": [
        [],
        [
          {
            "node": "Tem executor?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tem executor?": {
      "main": [
        [
          {
            "node": "Executar tarefa",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Sem executor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Executar tarefa": {
      "main": [
        [
          {
            "node": "Conferir resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Conferir resultado": {
      "main": [
        [
          {
            "node": "Reportar resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sem executor": {
      "main": [
        [
          {
            "node": "Reportar resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reportar resultado": {
      "main": [
        [
          {
            "node": "Processar em série",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
