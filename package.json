{
  "name": "orla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "ambiente:verificar": "node scripts/ambiente-verificar.mjs",
    "n8n:sincronizar": "node --experimental-strip-types scripts/n8n-sincronizar.mjs",
    "bq:verificar": "node scripts/bq/verificar-integridade.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml --project-directory . up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --project-directory . down",
    "db:migrate": "node scripts/migrate.mjs",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 tests/*.test.mjs",
    "verify": "npm run typecheck && npm run build && npm run test",
    "seguranca:verificar": "node scripts/seguranca-verificar.mjs --arvore",
    "ambiente:hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.109",
    "@ai-sdk/google": "4.0.127",
    "@ai-sdk/moonshotai": "3.0.96",
    "@ai-sdk/openai": "4.0.124",
    "@ai-sdk/xai": "5.0.51",
    "@google-cloud/bigquery": "^9.6.1",
    "@google-cloud/kms": "6.3.0",
    "@google-cloud/storage": "8.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ai": "7.0.182",
    "next": "16.4.5",
    "postgres": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.7.3"
  }
}
