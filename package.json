{
  "name": "orla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "n8n:sincronizar": "node --experimental-strip-types scripts/n8n-sincronizar.mjs",
    "bq:verificar": "node scripts/bq/verificar-integridade.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml --project-directory . up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --project-directory . down",
    "db:migrate": "node scripts/migrate.mjs",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 tests/*.test.mjs",
    "verify": "npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.6.1",
    "@google-cloud/storage": "8.4.0",
    "next": "16.4.5",
    "postgres": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
